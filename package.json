{
  "name": "mini-tunnel",
  "version": "0.1.0",
  "private": true,
  "description": "Public ứng dụng local (HTTP/WebSocket) qua Cloudflare Worker, có dashboard quản lý.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node client/src/index.js",
    "start:open": "node client/src/index.js --open",
    "setup": "node scripts/setup.js",
    "deploy": "npm --prefix worker run deploy",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  }
}
